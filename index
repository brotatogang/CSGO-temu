<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Budget Strike</title>
<style>
body {
    margin: 0;
    background: #222;
    overflow: hidden;
    font-family: Arial, sans-serif;
}

#ui {
    position: absolute;
    top: 10px;
    left: 10px;
    color: white;
    font-size: 20px;
}

canvas {
    background: #666;
    display: block;
}
</style>
</head>
<body>

<div id="ui">
    Health: <span id="health">100</span>
    |
    Kills: <span id="kills">0</span>
</div>

<canvas id="game"></canvas>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

const player = {
    x: canvas.width / 2,
    y: canvas.height / 2,
    size: 30,
    speed: 5,
    health: 100
};

let kills = 0;

const keys = {};

const bullets = [];
const enemies = [];

for (let i = 0; i < 8; i++) {
    spawnEnemy();
}

function spawnEnemy() {
    enemies.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        size: 25
    });
}

document.addEventListener("keydown", e => {
    keys[e.key.toLowerCase()] = true;
});

document.addEventListener("keyup", e => {
    keys[e.key.toLowerCase()] = false;
});

canvas.addEventListener("click", e => {
    const dx = e.clientX - player.x;
    const dy = e.clientY - player.y;
    const len = Math.hypot(dx, dy);

    bullets.push({
        x: player.x,
        y: player.y,
        vx: dx / len * 10,
        vy: dy / len * 10
    });
});

function update() {

    if (keys["w"]) player.y -= player.speed;
    if (keys["s"]) player.y += player.speed;
    if (keys["a"]) player.x -= player.speed;
    if (keys["d"]) player.x += player.speed;

    bullets.forEach((b, i) => {
        b.x += b.vx;
        b.y += b.vy;

        enemies.forEach((e, j) => {
            if (
                b.x > e.x &&
                b.x < e.x + e.size &&
                b.y > e.y &&
                b.y < e.y + e.size
            ) {
                bullets.splice(i, 1);
                enemies.splice(j, 1);
                kills++;
                spawnEnemy();
            }
        });
    });

    enemies.forEach(e => {
        const dx = player.x - e.x;
        const dy = player.y - e.y;
        const dist = Math.hypot(dx, dy);

        e.x += dx / dist * 1.2;
        e.y += dy / dist * 1.2;

        if (dist < 25) {
            player.health -= 0.2;
        }
    });

    document.getElementById("health").textContent =
        Math.max(0, Math.floor(player.health));

    document.getElementById("kills").textContent = kills;

    if (player.health <= 0) {
        alert("Game Over! Kills: " + kills);
        location.reload();
    }
}

function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Walls
    ctx.fillStyle = "#444";
    ctx.fillRect(300, 150, 200, 50);
    ctx.fillRect(700, 400, 50, 200);
    ctx.fillRect(1000, 250, 250, 50);

    // Player
    ctx.fillStyle = "blue";
    ctx.fillRect(
        player.x - player.size / 2,
        player.y - player.size / 2,
        player.size,
        player.size
    );

    // Enemies
    ctx.fillStyle = "red";
    enemies.forEach(e => {
        ctx.fillRect(e.x, e.y, e.size, e.size);
    });

    // Bullets
    ctx.fillStyle = "yellow";
    bullets.forEach(b => {
        ctx.fillRect(b.x, b.y, 5, 5);
    });

    // Crosshair
    ctx.strokeStyle = "white";
    ctx.beginPath();
    ctx.moveTo(mouseX - 10, mouseY);
    ctx.lineTo(mouseX + 10, mouseY);
    ctx.moveTo(mouseX, mouseY - 10);
    ctx.lineTo(mouseX, mouseY + 10);
    ctx.stroke();
}

let mouseX = 0;
let mouseY = 0;

document.addEventListener("mousemove", e => {
    mouseX = e.clientX;
    mouseY = e.clientY;
});

function gameLoop() {
    update();
    draw();
    requestAnimationFrame(gameLoop);
}

gameLoop();
</script>

</body>
</html>
